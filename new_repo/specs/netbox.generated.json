{
  "base_url": "/api",
  "entities": {
    "CircuitGroup": {
      "displayName": "circuitgroup",
      "operations": {
        "add": {
          "bodyTemplate": {
            "id": "{id}"
          },
          "descriptionTemplate": "Add circuit group {id}",
          "method": "POST",
          "name": "addCircuitGroup",
          "params": [
            "id"
          ],
          "path": "/circuits/circuit-groups/"
        },
        "delete": {
          "descriptionTemplate": "Delete circuit group {id}",
          "method": "DELETE",
          "name": "deleteCircuitGroup",
          "params": [
            "id"
          ],
          "path": "/circuits/circuit-groups/{id}/"
        },
        "get": {
          "descriptionTemplate": "Get circuit group {id}",
          "method": "GET",
          "name": "getCircuitGroup",
          "params": [
            "id"
          ],
          "path": "/circuits/circuit-groups/{id}/"
        },
        "update": {
          "bodyTemplate": {
            "id": "{id}"
          },
          "descriptionTemplate": "Update circuit group {id}",
          "method": "PUT",
          "name": "updateCircuitGroup",
          "params": [
            "id"
          ],
          "path": "/circuits/circuit-groups/{id}/"
        },
        "verifyExists": {
          "name": "verifyCircuitGroupExists"
        }
      },
      "params": [
        "id"
      ],
      "waitForPatterns": {
        "added": {
          "descriptionRegex": "Add circuit group (.+)",
          "name": "waitForAnyCircuitGroupAdded"
        },
        "deleted": {
          "descriptionRegex": "Delete circuit group (.+)",
          "name": "waitForAnyCircuitGroupDeleted"
        }
      }
