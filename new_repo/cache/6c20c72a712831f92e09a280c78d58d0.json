{
  "ConfigContexts": {
    "operations": {
      "delete": {
        "name": "extras_config_contexts_destroy",
        "descriptionTemplate": "Delete a config context object.",
        "method": "DELETE",
        "path": "/api/extras/config-contexts/{id}/",
        "params": [
          "id"
        ]
      },
      "get": {
        "name": "extras_config_contexts_retrieve",
        "descriptionTemplate": "Get a config context object.",
        "method": "GET",
        "path": "/api/extras/config-contexts/{id}/",
        "params": [
          "id"
        ]
      },
      "update": {
        "name": "extras_config_contexts_partial_update",
        "descriptionTemplate": "Patch a config context object.",
        "method": "PATCH",
        "path": "/api/extras/config-contexts/{id}/",
        "params": [
          "id"
        ],
        "bodyTemplate": {
          "patchedConfigContextRequest": "{patchedConfigContextRequest}"
        }
      },
      "put": {
        "name": "extras_config_contexts_update",
        "descriptionTemplate": "Put a config context object.",
        "method": "PUT",
        "path": "/api/extras/config-contexts/{id}/",
        "params": [
          "id"
        ],
        "bodyTemplate": {
          "configContextRequest": "{configContextRequest}"
        }
      },
      "add": {
        "name": "extras_config_contexts_sync_create",
        "descriptionTemplate": "Provide a /sync API endpoint to synchronize an object's data from its associated DataFile (if any).",
        "method": "POST",
        "path": "/api/extras/config-contexts/{id}/sync/",
        "params": [
          "id"
        ],
        "bodyTemplate": {
          "configContextRequest": "{configContextRequest}"
        }
      }
    }
  },
