{
  "base_url": "https://api.atlassian.com/ex/jira/{cloudid}/rest/api/3",
  "entities": {
    "Issue": {
      "displayName": "issue",
      "operations": {
        "add": {
          "bodyTemplate": {
            "key": "{issueIdOrKey}"
          },
          "descriptionTemplate": "Add issue {issueIdOrKey}",
          "method": "POST",
          "name": "addIssue",
          "params": [
            "issueIdOrKey"
          ],
          "path": "/issue"
        },
        "delete": {
          "descriptionTemplate": "Delete issue {issueIdOrKey}",
          "method": "DELETE",
          "name": "deleteIssue",
          "params": [
            "issueIdOrKey"
          ],
          "path": "/issue/{issueIdOrKey}"
        },
        "get": {
          "descriptionTemplate": "Get issue {issueIdOrKey}",
          "method": "GET",
          "name": "getIssue",
          "params": [
            "issueIdOrKey"
          ],
          "path": "/issue/{issueIdOrKey}"
        },
        "update": {
          "bodyTemplate": {
            "key": "{issueIdOrKey}"
          },
          "descriptionTemplate": "Update issue {issueIdOrKey}",
          "method": "PUT",
          "name": "updateIssue",
          "params": [
            "issueIdOrKey"
          ],
          "path": "/issue/{issueIdOrKey}"
        }
      },
      "params": [
        "issueIdOrKey"
      ],
      "waitForPatterns": {
        "added": {
          "descriptionRegex": "Add issue (.+)",
          "name": "waitForAnyIssueAdded"
        },
        "deleted": {
          "descriptionRegex": "Delete issue (.+)",
          "name": "waitForAnyIssueDeleted"
        }
      }
    },
