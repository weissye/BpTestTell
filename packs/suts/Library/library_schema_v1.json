{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schema_v1.json",
  "title": "Event Extraction Output (SCHEMA v1)",
  "type": "object",
  "required": [
    "system",
    "entities"
  ],
  "properties": {
    "system": {
      "type": "string"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "events"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "crud": {
            "type": "array",
            "items": {
              "enum": [
                "Create",
                "Read",
                "Update",
                "Delete"
              ]
            }
          },
          "apis": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "method",
                "path"
              ],
              "properties": {
                "method": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "operationId": {
                  "type": "string"
                },
                "params": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "summary": {
                  "type": "string"
                }
              }
            }
          },
          "events": {
            "type": "object",
            "required": [
              "low",
              "high"
            ],
            "properties": {
              "low": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "level"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "level": {
                      "enum": [
                        "low"
                      ]
                    },
                    "maps_to": {
                      "type": "object",
                      "required": [
                        "method",
                        "path"
                      ],
                      "properties": {
                        "method": {
                          "type": "string"
                        },
                        "path": {
                          "type": "string"
                        },
                        "operationId": {
                          "type": "string"
                        }
                      }
                    },
                    "pre": {
                      "type": "object"
                    },
                    "inputs": {
                      "type": "object"
                    },
                    "post": {
                      "type": "object"
                    },
                    "expectedErrors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "integer"
                          },
                          "reason": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "high": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "level",
                    "composition"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "level": {
                      "enum": [
                        "high"
                      ]
                    },
                    "composition": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "oracle": {
                      "type": "object"
                    },
                    "post": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entity",
          "reason"
        ],
        "properties": {
          "entity": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}