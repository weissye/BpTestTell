        "list": {
          "descriptionTemplate": "List documents in index {indexUid}",
          "method": "GET",
          "name": "listDocuments",
          "params": [
            "indexUid",
            "limit",
            "offset",
            "fields",
            "filter"
          ],
          "path": "/indexes/{indexUid}/documents"
        },
        "update": {
          "bodyTemplate": "[{document}]",
          "descriptionTemplate": "Update documents in index {indexUid}",
          "method": "PUT",
          "name": "updateDocuments",
          "params": [
            "indexUid",
            "primaryKey",
            "csvDelimiter"
          ],
          "path": "/indexes/{indexUid}/documents"
        },
        "verifyExists": {
          "name": "verifyDocumentExists"
