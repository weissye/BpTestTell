{
  "sut": "garage",
  "base_url": "http://localhost:8080",
  "entities": {
    "Chain": {
      "displayName": "chain",
      "params": [
        "chainId"
      ],
      "operations": {
        "add": {
          "name": "createChain",
          "method": "POST",
          "path": "/chains",
          "descriptionTemplate": "Create chain {name} with id {chainId}",
          "params": [
            "chainId",
            "name",
            "hqAddress"
          ],
          "bodyTemplate": {
            "chainId": "{chainId}",
            "name": "{name}",
            "hqAddress": "{hqAddress}",
            "supportEmail": "{supportEmail}",
            "active": "{active}"
          }
        },
        "get": {
          "name": "getChain",
          "method": "GET",
          "path": "/chains/{chainId}",
          "descriptionTemplate": "Get chain with id {chainId}",
          "params": [
            "chainId"
          ]
        },
        "update": {
          "name": "updateChain",
          "method": "PUT",
          "path": "/chains/{chainId}",
          "descriptionTemplate": "Update chain with id {chainId}",
          "params": [
            "chainId"
          ],
          "bodyTemplate": {
            "name": "{name}",
            "hqAddress": "{hqAddress}",
            "supportEmail": "{supportEmail}",
            "active": "{active}"
          }
        },
        "delete": {
          "name": "deleteChain",
          "method": "DELETE",
          "path": "/chains/{chainId}",
          "descriptionTemplate": "Delete chain with id {chainId}",
          "params": [
            "chainId"
          ]
        }
      }
    },
