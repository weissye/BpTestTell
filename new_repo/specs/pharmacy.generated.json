{
  "sut": "pharmacy",
  "base_url": "http://localhost:8080",
  "entities": {
    "Drug": {
      "displayName": "drug",
      "params": [
        "id"
      ],
      "operations": {
        "add": {
          "name": "createDrug",
          "method": "POST",
          "path": "/drugs",
          "descriptionTemplate": "Create drug {name} with id {id}",
          "params": [
            "id",
            "name"
          ],
          "bodyTemplate": {
            "id": "{id}",
            "name": "{name}"
          }
        },
        "get": {
          "name": "getDrug",
          "method": "GET",
          "path": "/drugs/{id}",
          "descriptionTemplate": "Get drug with id {id}",
          "params": [
            "id"
          ]
        },
        "update": {
          "name": "updateDrug",
          "method": "PUT",
          "path": "/drugs/{id}",
          "descriptionTemplate": "Update drug {name} with id {id}",
          "params": [
            "id",
            "name"
          ],
          "bodyTemplate": {
            "id": "{id}",
            "name": "{name}"
          }
        },
        "delete": {
          "name": "deleteDrug",
          "method": "DELETE",
