          "method": "POST",
          "name": "fetchDocuments",
          "params": [
            "indexUid",
            "offset",
            "limit",
            "fields",
            "filter"
          ],
          "path": "/indexes/{indexUid}/documents/fetch"
        },
        "get": {
          "descriptionTemplate": "Get document {documentId} from index {indexUid}",
          "method": "GET",
          "name": "getDocument",
          "params": [
            "indexUid",
            "documentId",
            "fields"
          ],
          "path": "/indexes/{indexUid}/documents/{documentId}"
