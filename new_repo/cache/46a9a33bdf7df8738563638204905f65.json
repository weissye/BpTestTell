{
  "Users": {
    "operations": {
      "list": {
        "name": "userListSubscriptions",
        "descriptionTemplate": "List the repositories watched by a user",
        "method": "GET",
        "path": "/users/{username}/subscriptions",
        "params": [
          "username",
          "page",
          "limit"
        ],
        "bodyTemplate": null,
        "paramTypes": {
          "username": "string",
          "page": "integer",
          "limit": "integer"
        }
      },
      "get": {
        "name": "userGetTokens",
        "descriptionTemplate": "List the authenticated user's access tokens",
        "method": "GET",
        "path": "/users/{username}/tokens",
        "params": [
          "username",
          "page",
          "limit"
        ],
        "bodyTemplate": null,
        "paramTypes": {
          "username": "string",
          "page": "integer",
          "limit": "integer"
        }
      },
      "add": {
        "name": "userCreateToken",
        "descriptionTemplate": "Create an access token",
        "method": "POST",
        "path": "/users/{username}/tokens",
        "params": [
          "username"
        ],
        "bodyTemplate": {
          "name": "{name}",
          "scopes": [
            "{scope}"
          ]
        },
        "paramTypes": {
          "username": "string",
          "name": "string",
          "scope": "string"
        }
      },
      "delete": {
        "name": "userDeleteAccessToken",
        "descriptionTemplate": "Delete an access token",
        "method": "DELETE",
        "path": "/users/{username}/tokens/{token}",
        "params": [
          "username",
          "token"
        ],
        "bodyTemplate": null,
        "paramTypes": {
          "username": "string",
          "token": "string"
        },
        "x-negative-delete-expected-codes": [
          404
        ]
      }
    }
  },
  "Miscellaneous": {
    "operations": {
      "get": {
        "name": "getVersion",
        "descriptionTemplate": "Returns the version of the Gitea application",
        "method": "GET",
        "path": "/version",
        "params": [],
        "bodyTemplate": null,
        "paramTypes": {}
      }
    }
  }
}