{
  "base_url": "",
  "entities": {
    "Book": {
      "displayName": "book",
      "operations": {
        "add": {
          "bodyTemplate": {
            "id": "{id}",
            "title": "{title}"
          },
          "descriptionTemplate": "Add book {id}",
          "method": "POST",
          "name": "addBook",
          "params": [
            "id",
            "title"
          ],
          "path": "/books"
        },
        "delete": {
          "descriptionTemplate": "Delete book {book_id}",
          "method": "DELETE",
          "name": "deleteBook",
          "params": [
            "book_id"
          ],
          "path": "/books/{book_id}"
        },
        "get": {
          "descriptionTemplate": "Get book {book_id}",
          "method": "GET",
          "name": "getBook",
          "params": [
            "book_id"
          ],
          "path": "/books/{book_id}"
        },
        "list": {
          "descriptionTemplate": "List books with query {q}",
          "method": "GET",
          "name": "listBooks",
          "params": [
            "q"
          ],
          "path": "/books"
        }
      },
      "params": [
        "book_id",
        "q",
        "id",
        "title"
      ],
      "waitForPatterns": {
        "added": {
          "descriptionRegex": "Add book (.+)",
          "name": "waitForAnyBookAdded"
        },
        "deleted": {
          "descriptionRegex": "Delete book (.+)",
          "name": "waitForAnyBookDeleted"
        }
      }
    },
    "Hold": {
      "displayName": "hold",
      "operations": {
        "add": {
          "bodyTemplate": {
            "bookId": "{bookId}",
            "hold_id": "{hold_id}",
            "userId": "{userId}"
          },
          "descriptionTemplate": "Add hold {hold_id}",
          "method": "POST",
          "name": "addHold",
          "params": [
            "hold_id",
            "userId",
            "bookId"
          ],
          "path": "/holds"
        },
        "delete": {
          "descriptionTemplate": "Delete hold {hold_id}",
          "method": "DELETE",
          "name": "deleteHold",
          "params": [
            "hold_id"
          ],
          "path": "/holds/{hold_id}"
        },
        "get": {
          "descriptionTemplate": "Get holds",
          "method": "GET",
          "name": "getHolds",
          "params": [],
          "path": "/holds"
        }
      },
      "params": [
        "hold_id",
        "userId",
        "bookId"
      ],
      "waitForPatterns": {
        "added": {
          "descriptionRegex": "Add hold (.+)",
          "name": "waitForAnyHoldAdded"
        },
        "deleted": {
          "descriptionRegex": "Delete hold (.+)",
          "name": "waitForAnyHoldDeleted"
        }
      }
    },
    "Loan": {
      "displayName": "loan",
      "operations": {
        "add": {
          "bodyTemplate": {
            "bookId": "{bookId}",
            "userId": "{userId}"
          },
          "descriptionTemplate": "Add loan user {userId} book {bookId}",
          "method": "POST",
          "name": "addLoan",
          "params": [
            "userId",
            "bookId"
          ],
          "path": "/loans"
        },
        "delete": {
          "descriptionTemplate": "Delete loan user {user_id} book {book_id}",
          "method": "DELETE",
          "name": "deleteLoan",
          "params": [
            "user_id",
            "book_id"
          ],
          "path": "/loans/{user_id}/{book_id}"
        },
        "get": {
          "descriptionTemplate": "Get loans with userId {userId} and bookId {bookId}",
          "method": "GET",
          "name": "getLoans",
          "params": [
            "userId",
            "bookId"
          ],
          "path": "/loans"
        }
      },
      "params": [
        "user_id",
        "book_id",
        "userId",
        "bookId"
      ],
      "waitForPatterns": {
        "added": {
          "descriptionRegex": "Add loan user (.+) book (.+)",
          "name": "waitForAnyLoanAdded"
        },
        "deleted": {
          "descriptionRegex": "Delete loan user (.+) book (.+)",
          "name": "waitForAnyLoanDeleted"
        }
      }
    },
    "User": {
      "displayName": "user",
      "operations": {
        "add": {
          "bodyTemplate": {
            "id": "{id}",
            "name": "{name}"
          },
          "descriptionTemplate": "Add user {id}",
          "method": "POST",
          "name": "addUser",
          "params": [
            "id",
            "name"
          ],
          "path": "/users"
        },
        "delete": {
          "descriptionTemplate": "Delete user {user_id}",
          "method": "DELETE",
          "name": "deleteUser",
          "params": [
            "user_id"
          ],
          "path": "/users/{user_id}"
        },
        "get": {
          "descriptionTemplate": "Get users with query {q}",
          "method": "GET",
          "name": "getUsers",
          "params": [
            "q"
          ],
          "path": "/users"
        }
      },
      "params": [
        "user_id",
        "q",
        "id",
        "name"
      ],
      "waitForPatterns": {
        "added": {
          "descriptionRegex": "Add user (.+)",
          "name": "waitForAnyUserAdded"
        },
        "deleted": {
          "descriptionRegex": "Delete user (.+)",
          "name": "waitForAnyUserDeleted"
        }
      }
    }
  },
  "sut": "library"
}