  "base_url": "",
  "entities": {
    "App": {
      "displayName": "app",
      "operations": {
        "add": {
          "bodyTemplate": {
            "id": "{appId}"
          },
          "descriptionTemplate": "Add app {appId}",
          "method": "POST",
          "name": "addApp",
          "params": [
            "appId"
          ],
          "path": "/apps"
        },
        "get": {
          "descriptionTemplate": "Get app {appId}",
          "method": "GET",
          "name": "getApp",
          "params": [
            "appId"
          ],
          "path": "/apps"
        }
      },
      "params": [
        "appId"
      ],
      "waitForPatterns": {
        "added": {
          "descriptionRegex": "Add app (.+)",
          "name": "waitForAnyAppAdded"
        }
      }
    },
