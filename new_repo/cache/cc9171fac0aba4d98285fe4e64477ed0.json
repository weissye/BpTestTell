{
  "PullRequests": {
    "operations": {
      "list": {
        "name": "repoGetPullRequestCommits",
        "descriptionTemplate": "Get commits for a pull request",
        "method": "GET",
        "path": "/repos/{owner}/{repo}/pulls/{index}/commits",
        "params": [
          "owner",
          "repo",
          "index",
          "page",
          "limit",
          "verification",
          "files"
        ],
        "bodyTemplate": {},
        "paramTypes": {
          "owner": "string",
          "repo": "string",
          "index": "integer",
          "page": "integer",
          "limit": "integer",
          "verification": "boolean",
          "files": "boolean"
        },
        "x-negative-delete-expected-codes": [
          404
        ]
      },
      "get": {
        "name": "repoDownloadPullDiffOrPatch",
        "descriptionTemplate": "Get a pull request diff or patch",
        "method": "GET",
        "path": "/repos/{owner}/{repo}/pulls/{index}.{diffType}",
        "params": [
          "owner",
          "repo",
          "index",
          "diffType",
          "binary"
        ],
        "bodyTemplate": {},
        "paramTypes": {
          "owner": "string",
          "repo": "string",
          "index": "integer",
          "diffType": "string",
          "binary": "boolean"
        },
        "x-negative-delete-expected-codes": [
          404
        ]
      },
      "update": {
        "name": "repoEditPullRequest",
        "descriptionTemplate": "Update a pull request. If using deadline only the date will be taken into account, and time of day ignored.",
        "method": "PATCH",
        "path": "/repos/{owner}/{repo}/pulls/{index}",
        "params": [
          "owner",
          "repo",
          "index"
        ],
        "bodyTemplate": {
          "body": "{body}"
        },
        "paramTypes": {
          "owner": "string",
          "repo": "string",
          "index": "integer",
          "body": "object"
        },
        "x-negative-delete-expected-codes": [
          404,
          403,
          409,
          412,
          422
        ]
      }
    }
  }
}