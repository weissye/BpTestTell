{
  "Utilities": {
    "operations": {
      "add": {
        "name": "sort",
        "descriptionTemplate": "Re-sort items in collection based on start and to value of item",
        "method": "POST",
        "path": "/utils/sort/{collection}",
        "params": [
          "collection",
          "id"
        ],
        "bodyTemplate": {
          "item": "{item}",
          "to": "{to}"
        },
        "paramTypes": {
          "collection": "string",
          "item": "number",
          "to": "number",
          "id": "string"
        }
      }
    }
  }
}