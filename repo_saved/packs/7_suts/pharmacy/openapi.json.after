                "schema": {
                  "$ref": "#/components/schemas/Drug"
                }
              }
            }
          }
        }
      },
      "put": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Drug"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "updated"
          }
        }
      },
      "delete": {
        "responses": {
          "200": {
            "description": "deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Deleted"
                }
              }
            }
          }
        }
      }
    },
