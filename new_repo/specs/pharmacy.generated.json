{
  "sut": "pharmacy",
  "entities": {
    "Drug": {
      "displayName": "drug",
      "params": [
        "id",
        "name"
      ],
      "operations": {
        "add": {
          "name": "addDrug",
          "method": "POST",
          "path": "/drugs",
          "descriptionTemplate": "Add a drug with id {id} and name {name}",
          "bodyTemplate": {
            "id": "{id}",
            "name": "{name}"
          }
        },
        "delete": {
          "name": "deleteDrug",
          "method": "DELETE",
          "path": "/drugs/{id}",
          "descriptionTemplate": "Delete a drug with id {id} and name {name}"
        },
        "verifyExists": {
          "name": "verifyDrugExists"
        }
      },
      "waitForPatterns": {
        "added": {
          "name": "waitForAnyDrugAdded",
          "descriptionRegex": "Add a drug with id (.+) and name (.+)"
        },
        "deleted": {
          "name": "waitForAnyDrugDeleted",
          "descriptionRegex": "Delete a drug with id (.+) and name (.+)"
        }
      }
    },
