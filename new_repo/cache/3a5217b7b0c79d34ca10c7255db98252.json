{
  "UserKeys": {
    "operations": {
      "add": {
        "name": "adminCreatePublicKey",
        "descriptionTemplate": "Add a public key on behalf of a user",
        "method": "POST",
        "path": "/admin/users/{username}/keys",
        "params": [
          "username"
        ],
        "bodyTemplate": {
          "key": "{key}"
        },
        "paramTypes": {
          "username": "string",
          "key": "string"
        }
      },
      "delete": {
        "name": "adminDeleteUserPublicKey",
        "descriptionTemplate": "Delete a user's public key",
        "method": "DELETE",
        "path": "/admin/users/{username}/keys/{id}",
        "params": [
          "username",
          "id"
        ],
        "bodyTemplate": {},
        "paramTypes": {
          "username": "string",
          "id": "integer"
        },
        "x-negative-delete-expected-codes": [
          404
        ]
      }
    }
  },
  "UserOrganizations": {
    "operations": {
      "add": {
        "name": "adminCreateOrg",
        "descriptionTemplate": "Create an organization",
        "method": "POST",
        "path": "/admin/users/{username}/orgs",
        "params": [
          "username"
        ],
        "bodyTemplate": {
          "organization": "{organization}"
        },
        "paramTypes": {
          "username": "string",
          "organization": "string"
        }
      }
    }
  },
  "UserRename": {
    "operations": {
      "add": {
        "name": "adminRenameUser",
        "descriptionTemplate": "Rename a user",
        "method": "POST",
        "path": "/admin/users/{username}/rename",
        "params": [
          "username"
        ],
        "bodyTemplate": {
          "body": "{body}"
        },
        "paramTypes": {
          "username": "string",
          "body": "string"
        }
      }
    }
  },
  "UserRepositories": {
    "operations": {
      "add": {
        "name": "adminCreateRepo",
        "descriptionTemplate": "Create a repository on behalf of a user",
        "method": "POST",
        "path": "/admin/users/{username}/repos",
        "params": [
          "username"
        ],
        "bodyTemplate": {
          "repository": "{repository}"
        },
        "paramTypes": {
          "username": "string",
          "repository": "string"
        }
      }
    }
  }
}