  "DeviceRoles": {
    "operations": {
      "delete": {
        "name": "dcim_device_roles_destroy",
        "descriptionTemplate": "Delete a device role object.",
        "method": "DELETE",
        "path": "/api/dcim/device-roles/{id}/",
        "params": [
          "id"
        ]
      },
      "get": {
        "name": "dcim_device_roles_retrieve",
        "descriptionTemplate": "Get a device role object.",
        "method": "GET",
        "path": "/api/dcim/device-roles/{id}/",
        "params": [
          "id"
        ]
      },
      "update": {
        "name": "dcim_device_roles_update",
        "descriptionTemplate": "Put a device role object.",
        "method": "PUT",
        "path": "/api/dcim/device-roles/{id}/",
        "params": [
          "id"
        ],
        "bodyTemplate": {
          "name": "{name}",
          "device_role": "{device_role}"
        }
      }
    }
  },
