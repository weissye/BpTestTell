    "Chain": {
      "displayName": "chain",
      "params": [
        "chainId",
        "name",
        "hqAddress",
        "supportEmail",
        "active"
      ],
      "operations": {
        "add": {
          "name": "addChain",
          "method": "POST",
          "path": "/chains",
          "descriptionTemplate": "Add a chain with id {chainId} and name {name}",
          "bodyTemplate": {
            "chainId": "{chainId}",
            "name": "{name}",
            "hqAddress": "{hqAddress}",
            "supportEmail": "{supportEmail}",
            "active": "{active}"
          }
        },
        "delete": {
          "name": "deleteChain",
          "method": "DELETE",
          "path": "/chains/{chainId}",
          "descriptionTemplate": "Delete a chain with id {chainId} and name {name}"
        },
        "verifyExists": {
          "name": "verifyChainExists"
        }
      },
      "waitForPatterns": {
        "added": {
          "name": "waitForAnyChainAdded",
          "descriptionRegex": "Add a chain with id (.+) and name (.+)"
        },
        "deleted": {
          "name": "waitForAnyChainDeleted",
          "descriptionRegex": "Delete a chain with id (.+) and name (.+)"
        }
      }
    },
