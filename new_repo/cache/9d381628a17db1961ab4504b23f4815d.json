{
  "Repositories": {
    "operations": {
      "get": {
        "name": "repoGetEditorConfig",
        "descriptionTemplate": "Get the EditorConfig definitions of a file in a repository",
        "method": "GET",
        "path": "/repos/{owner}/{repo}/editorconfig/{filepath}",
        "params": [
          "owner",
          "repo",
          "filepath",
          "ref"
        ],
        "bodyTemplate": {},
        "paramTypes": {
          "owner": "string",
          "repo": "string",
          "filepath": "string",
          "ref": "string"
        },
        "x-negative-delete-expected-codes": [
          404
        ]
      },
      "list": {
        "name": "repoGetContentsList",
        "descriptionTemplate": "Gets the metadata of all the entries of the root dir",
        "method": "GET",
        "path": "/repos/{owner}/{repo}/contents",
        "params": [
          "owner",
          "repo",
          "ref"
        ],
        "bodyTemplate": {},
        "paramTypes": {
          "owner": "string",
          "repo": "string",
          "ref": "string"
        },
        "x-negative-delete-expected-codes": [
          404
        ]
      },
      "add": {
        "name": "repoApplyDiffPatch",
        "descriptionTemplate": "Apply diff patch to repository",
        "method": "POST",
        "path": "/repos/{owner}/{repo}/diffpatch",
        "params": [
          "owner",
          "repo"
        ],
        "bodyTemplate": {
          "body": "{UpdateFileOptions}"
        },
        "paramTypes": {
          "owner": "string",
          "repo": "string",
          "body": "object"
        },
        "x-negative-delete-expected-codes": [
          404,
          423
        ]
      },
      "delete": {
        "name": "repoDeleteFile",
        "descriptionTemplate": "Delete a file in a repository",
        "method": "DELETE",
        "path": "/repos/{owner}/{repo}/contents/{filepath}",
        "params": [
          "owner",
          "repo",
          "filepath"
        ],
        "bodyTemplate": {
          "body": "{DeleteFileOptions}"
        },
        "paramTypes": {
          "owner": "string",
          "repo": "string",
          "filepath": "string",
          "body": "object"
        },
        "x-negative-delete-expected-codes": [
          400,
          403,
          404,
          423
        ]
      },
      "update": {
        "name": "repoUpdateFile",
        "descriptionTemplate": "Update a file in a repository",
        "method": "PUT",
        "path": "/repos/{owner}/{repo}/contents/{filepath}",
        "params": [
          "owner",
          "repo",
          "filepath"
        ],
        "bodyTemplate": {
          "body": "{UpdateFileOptions}"
        },
        "paramTypes": {
          "owner": "string",
          "repo": "string",
          "filepath": "string",
          "body": "object"
        },
        "x-negative-delete-expected-codes": [
          403,
          404,
          422,
          423
        ]
      }
    }
  }
}