        "path": "/repos/{owner}/{repo}/issues/comments/{id}/assets/{attachment_id}",
        "params": [
          "owner",
          "repo",
          "id",
          "attachment_id",
          "body"
        ],
        "bodyTemplate": {
          "body": "{body}"
        },
        "paramTypes": {
          "owner": "string",
          "repo": "string",
          "id": "integer",
          "attachment_id": "integer",
          "body": "object"
        },
        "x-negative-delete-expected-codes": [
          404,
          422,
          423
        ]
      },
      "delete": {
        "name": "issueDeleteIssueCommentAttachment",
        "descriptionTemplate": "Delete a comment attachment",
