{
  "IssueCommentAttachments": {
    "operations": {
      "list": {
        "name": "issueListIssueCommentAttachments",
        "descriptionTemplate": "List comment's attachments",
        "method": "GET",
        "path": "/repos/{owner}/{repo}/issues/comments/{id}/assets",
        "params": [
          "owner",
          "repo",
          "id"
        ],
        "bodyTemplate": null,
        "paramTypes": {
