        "params": [
          "owner",
          "repo",
          "index",
          "attachment_id"
        ],
        "bodyTemplate": {
          "body": "{body}"
        },
        "paramTypes": {
          "owner": "string",
          "repo": "string",
          "index": "integer",
          "attachment_id": "integer",
          "body": "object"
        }
      },
      "delete": {
        "name": "issueDeleteIssueAttachment",
        "descriptionTemplate": "Delete an issue attachment",
