{
  "Users": {
    "operations": {
      "add": {
        "name": "acceptInvite",
        "descriptionTemplate": "Accepts and enables an invited user using a JWT invitation token.",
        "method": "POST",
        "path": "/users/invite/accept",
        "params": [
          "password",
          "token"
        ],
        "bodyTemplate": {
          "password": "{password}",
          "token": "{token}"
        },
        "paramTypes": {
          "password": "string",
          "token": "string"
        }
      },
      "get": {
        "name": "getMe",
        "descriptionTemplate": "Retrieve the currently authenticated user.",
        "method": "GET",
        "path": "/users/me",
        "params": [],
        "bodyTemplate": null,
        "paramTypes": {}
      },
      "update": {
        "name": "updateMe",
        "descriptionTemplate": "Update the currently authenticated user.",
        "method": "PATCH",
        "path": "/users/me",
        "params": [],
        "bodyTemplate": null,
        "paramTypes": {}
      },
      "disableTfa": {
        "name": "meTfaDisable",
        "descriptionTemplate": "Disables two-factor authentication for the currently authenticated user.",
        "method": "POST",
        "path": "/users/me/tfa/disable",
        "params": [],
        "bodyTemplate": null,
        "paramTypes": {}
      },
      "enableTfa": {
        "name": "meTfaEnable",
        "descriptionTemplate": "Enables two-factor authentication for the currently authenticated user.",
        "method": "POST",
        "path": "/users/me/tfa/enable",
        "params": [],
        "bodyTemplate": null,
        "paramTypes": {}
      },
      "updateLastPage": {
        "name": "updateLastUsedPageMe",
        "descriptionTemplate": "Updates the last used page field of the currently authenticated user.",
        "method": "PATCH",
        "path": "/users/me/track/page",
        "params": [
          "last_page"
        ],
        "bodyTemplate": {
          "last_page": "{last_page}"
        },
        "paramTypes": {
          "last_page": "string"
        }
      }
    }
  }
}