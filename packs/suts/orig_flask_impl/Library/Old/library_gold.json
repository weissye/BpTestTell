                200
              ]
            },
            "expectedErrors": [
              {
                "status": 404,
                "reason": "not-found"
              }
            ]
          },
          {
            "name": "user.delete.api",
            "level": "low",
            "maps_to": {
              "method": "DELETE",
              "path": "/users/{user_id}",
              "operationId": "deleteUser"
            },
            "pre": {
              "auth": "librarian"
            },
            "inputs": {
              "user_id": "string"
            },
            "post": {
              "status": [
                204
              ]
            },
            "expectedErrors": [
              {
                "status": 404,
                "reason": "not-found"
              },
              {
                "status": 400,
                "reason": "user-has-active-loans"
              }
            ]
          },
          {
            "name": "user.list.api",
            "level": "low",
            "maps_to": {
              "method": "GET",
              "path": "/users",
              "operationId": "listUsers"
            },
            "pre": {
              "auth": "any"
            },
            "inputs": {},
            "post": {
              "status": [
                200
              ],
              "json.isArray": true
            }
          }
        ],
        "high": [
          {
            "name": "RegisterUserThenVerify",
            "level": "high",
            "composition": [
              "user.create.api",
              "user.read.api"
            ],
            "oracle": {
              "assert": "created.id != null"
            }
          },
          {
            "name": "DeleteUserSafely",
            "level": "high",
            "composition": [
              "user.read.api",
              "user.delete.api",
              "user.read.api"
            ],
            "oracle": {
              "assert": "second_read.status == 404"
            }
          }
        ]
      }
    },
