    "openapi": "3.0.3",
    "info": {
      "title": "Pharmacy API (Option 3: Idempotent DELETE + Conflict on Duplicates)",
      "version": "1.0.3",
      "description": "CRUD demo API. POST enforces required key and returns 409 on duplicates (400 on missing key). DELETE is idempotent (200 even if not found)."
    },
    "servers": [
      {
        "url": "http://192.168.225.53:5014"
      },
      {
        "url": "http://localhost:5014"
      }
    ],
    "paths": {
      "/drugs": {
        "x-key": "id",
        "get": {
          "summary": "List drugs",
          "responses": {
            "200": {
              "description": "list",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Drug"
                    }
                  }
                }
              }
            }
          }
        },
        "post": {
          "summary": "Create drug",
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Drug"
                }
              }
            }
          },
          "responses": {
            "201": {
              "description": "created",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Drug"
                  }
                }
              }
            },
            "400": {
              "description": "missing required key (id) or malformed request",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            },
            "409": {
              "description": "duplicate drug (conflict)",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            }
          },
          "x-create-expected-codes": [
            201,
            200
          ],
          "x-duplicate-policy": "conflict",
          "x-duplicate-expected-codes": [
            409,
            400
          ]
        }
      },
