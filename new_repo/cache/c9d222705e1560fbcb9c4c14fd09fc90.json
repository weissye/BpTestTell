{
  "Issues": {
    "operations": {
      "update": {
        "name": "issueReplaceLabels",
        "descriptionTemplate": "Replace an issue's labels",
        "method": "PUT",
        "path": "/repos/{owner}/{repo}/issues/{index}/labels",
        "params": [
          "owner",
          "repo",
          "index"
        ],
        "bodyTemplate": {
          "labels": "{labels}"
        },
        "paramTypes": {
          "owner": "string",
          "repo": "string",
          "index": "integer",
          "labels": "string"
        },
        "x-negative-delete-expected-codes": [
          404
        ]
      },
      "delete": {
        "name": "unpinIssue",
