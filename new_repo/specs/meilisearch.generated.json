          "method": "POST",
          "name": "addDocuments",
          "params": [
            "indexUid",
            "primaryKey",
            "csvDelimiter"
          ],
          "path": "/indexes/{indexUid}/documents"
        },
        "delete": {
          "descriptionTemplate": "Delete all documents in index {indexUid}",
