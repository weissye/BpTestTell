{
  "system": "Library",
  "entities": [
    {
      "name": "Book",
      "crud": [
        "Create",
        "Read",
        "Update",
        "Delete"
      ],
      "apis": [
        {
          "method": "POST",
          "path": "/books",
          "operationId": "createBook"
        },
        {
          "method": "GET",
          "path": "/books",
          "operationId": "listBooks"
        },
        {
          "method": "GET",
          "path": "/books/{id}",
          "operationId": "readBook"
        },
        {
          "method": "PUT",
          "path": "/books/{id}",
          "operationId": "updateBook"
        },
        {
          "method": "DELETE",
          "path": "/books/{id}",
          "operationId": "deleteBook"
        }
      ],
      "events": {
        "low": [
          {
            "name": "book.create.api",
            "level": "low",
            "maps_to": {
              "method": "POST",
              "path": "/books",
              "operationId": "createBook"
            },
            "pre": {
              "auth": "librarian"
            },
            "inputs": {
              "id": "string",
              "title": "string",
              "author": "string"
            },
            "post": {
              "status": [
                201
              ],
              "json.has": [
                "id",
                "title",
                "author"
              ]
            },
            "expectedErrors": [
              {
                "status": 400,
                "reason": "duplicate-id"
              }
            ]
          },
          {
            "name": "book.read.api",
            "level": "low",
            "maps_to": {
              "method": "GET",
              "path": "/books/{book_id}",
              "operationId": "readBook"
            },
            "pre": {
              "auth": "any"
            },
            "inputs": {
              "book_id": "string"
            },
            "post": {
              "status": [
                200
              ],
              "json.has": [
                "id",
                "title",
                "author"
              ]
            },
            "expectedErrors": [
              {
                "status": 404,
                "reason": "not-found"
              }
            ]
          },
          {
            "name": "book.update.api",
            "level": "low",
            "maps_to": {
              "method": "PUT",
              "path": "/books/{book_id}",
              "operationId": "updateBook"
            },
            "pre": {
              "auth": "librarian"
            },
            "inputs": {
              "title?": "string",
              "author?": "string",
              "book_id": "string"
            },
            "post": {
              "status": [
                200
              ]
            },
            "expectedErrors": [
              {
                "status": 404,
                "reason": "not-found"
              }
            ]
          },
          {
            "name": "book.delete.api",
            "level": "low",
            "maps_to": {
              "method": "DELETE",
              "path": "/books/{book_id}",
              "operationId": "deleteBook"
            },
            "pre": {
              "auth": "librarian"
            },
            "inputs": {
              "book_id": "string"
            },
            "post": {
              "status": [
                204
              ]
            },
            "expectedErrors": [
              {
                "status": 404,
                "reason": "not-found"
              },
              {
                "status": 400,
                "reason": "book-in-loan"
              }
            ]
          },
          {
            "name": "book.list.api",
            "level": "low",
            "maps_to": {
              "method": "GET",
              "path": "/books",
              "operationId": "listBooks"
            },
            "pre": {
              "auth": "any"
            },
            "inputs": {},
            "post": {
              "status": [
                200
              ],
              "json.isArray": true
            }
          }
        ],
        "high": [
          {
            "name": "AddNewBook",
            "level": "high",
            "composition": [
              "book.create.api",
              "book.read.api"
            ],
            "oracle": {
              "assert": "created.id != null"
            }
          },
          {
            "name": "UpdateBookThenVerify",
            "level": "high",
            "composition": [
              "book.update.api",
              "book.read.api"
            ],
            "oracle": {
              "assert": "read.title == updated.title"
            }
          },
          {
            "name": "DeleteBookSafely",
            "level": "high",
            "composition": [
              "book.read.api",
              "book.delete.api",
              "book.read.api"
            ],
            "oracle": {
              "assert": "second_read.status == 404"
            }
          }
        ]
      }
    },
    {
