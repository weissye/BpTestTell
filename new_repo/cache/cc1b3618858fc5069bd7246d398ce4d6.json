        "descriptionTemplate": "Create a comment attachment",
        "method": "POST",
        "path": "/repos/{owner}/{repo}/issues/comments/{id}/assets",
        "params": [
          "owner",
          "repo",
          "id",
          "name",
          "attachment"
        ],
        "bodyTemplate": {
          "name": "{name}",
          "attachment": "{attachment}"
        },
        "paramTypes": {
