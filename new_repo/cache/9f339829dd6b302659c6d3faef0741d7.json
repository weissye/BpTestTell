  "BranchProtections": {
    "operations": {
      "delete": {
        "name": "repoDeleteBranchProtection",
        "descriptionTemplate": "Delete a specific branch protection for the repository",
        "method": "DELETE",
        "path": "/repos/{owner}/{repo}/branch_protections/{name}",
        "params": [
          "owner",
          "repo",
          "name"
        ],
        "bodyTemplate": {},
        "paramTypes": {
          "owner": "string",
          "repo": "string",
          "name": "string"
        },
        "x-negative-delete-expected-codes": [
          404
        ]
      },
      "get": {
        "name": "repoGetBranchProtection",
        "descriptionTemplate": "Get a specific branch protection for the repository",
        "method": "GET",
        "path": "/repos/{owner}/{repo}/branch_protections/{name}",
        "params": [
          "owner",
          "repo",
          "name"
        ],
        "bodyTemplate": {},
        "paramTypes": {
          "owner": "string",
          "repo": "string",
          "name": "string"
        }
      },
      "update": {
        "name": "repoEditBranchProtection",
        "descriptionTemplate": "Edit a branch protections for a repository. Only fields that are set will be changed",
        "method": "PATCH",
        "path": "/repos/{owner}/{repo}/branch_protections/{name}",
        "params": [
          "owner",
          "repo",
          "name"
        ],
        "bodyTemplate": {
