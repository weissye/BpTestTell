              "method": "POST",
              "path": "/chains",
              "operationId": "createChain"
            },
            "pre": {
              "auth": "admin"
            },
            "inputs": {
              "chainId": "string",
              "name": "string",
              "hqAddress": "object"
            },
            "post": {
              "status": [
                201
              ]
            },
            "expectedErrors": [
              {
                "status": 400,
                "reason": "duplicate-id"
              }
            ]
          },
          {
            "name": "chain.read.api",
            "level": "low",
            "maps_to": {
              "method": "GET",
              "path": "/chains/{chainId}",
              "operationId": "readChain"
            },
            "pre": {
              "auth": "staff"
            },
            "inputs": {
              "chainId": "string"
            },
            "post": {
              "status": [
                200
              ]
            },
            "expectedErrors": [
              {
                "status": 404,
                "reason": "not-found"
              }
            ]
          },
          {
            "name": "chain.update.api",
            "level": "low",
            "maps_to": {
              "method": "PUT",
              "path": "/chains/{chainId}",
              "operationId": "updateChain"
            },
            "pre": {
              "auth": "admin"
            },
            "inputs": {
              "chainId": "string",
              "payload": "object"
            },
            "post": {
              "status": [
                200
              ]
            },
            "expectedErrors": [
              {
                "status": 404,
                "reason": "not-found"
              }
            ]
          },
          {
            "name": "chain.delete.api",
            "level": "low",
            "maps_to": {
              "method": "DELETE",
              "path": "/chains/{chainId}",
              "operationId": "deleteChain"
            },
            "pre": {
              "auth": "admin"
            },
            "inputs": {
              "chainId": "string"
            },
            "post": {
              "status": [
                204
              ]
            },
            "expectedErrors": [
              {
                "status": 404,
                "reason": "not-found"
              },
              {
                "status": 400,
                "reason": "chain-has-garages"
              }
            ]
          },
          {
            "name": "chain.list.api",
            "level": "low",
            "maps_to": {
              "method": "GET",
              "path": "/chains",
              "operationId": "listChains"
            },
            "pre": {
              "auth": "staff"
            },
            "inputs": {},
            "post": {
              "status": [
                200
              ],
              "json.isArray": true
            }
          }
        ],
        "high": [
          {
            "name": "RegisterChainThenVerify",
            "level": "high",
            "composition": [
              "chain.create.api",
              "chain.read.api"
            ],
            "oracle": {
              "assert": "created.status == 201 && read.status == 200"
            }
          },
          {
            "name": "DeleteChainSafely",
            "level": "high",
            "composition": [
              "chain.read.api",
              "chain.delete.api",
              "chain.read.api"
            ],
            "oracle": {
              "assert": "second_read.status == 404"
            }
          }
        ]
      }
