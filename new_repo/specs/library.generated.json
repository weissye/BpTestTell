{
  "sut": "library",
  "base_url": "http://localhost:8080",
  "entities": {
    "User": {
      "displayName": "user",
      "params": [
        "id"
      ],
      "operations": {
        "add": {
          "name": "createUser",
          "method": "POST",
          "path": "/users",
          "descriptionTemplate": "Create a user with id {id}",
          "params": [
            "id"
          ],
          "bodyTemplate": {
            "id": "{id}"
          }
        },
        "delete": {
          "name": "deleteUser",
          "method": "DELETE",
          "path": "/users/{id}",
          "descriptionTemplate": "Delete user with id {id}",
          "params": [
            "id"
          ]
        },
        "get": {
          "name": "listUsers",
          "method": "GET",
          "path": "/users",
          "descriptionTemplate": "List/search users"
        }
      }
    },
    "Book": {
      "displayName": "book",
      "params": [
        "id"
      ],
      "operations": {
        "add": {
          "name": "createBook",
          "method": "POST",
          "path": "/books",
          "descriptionTemplate": "Create a book with id {id}",
          "params": [
            "id"
          ],
          "bodyTemplate": {
            "id": "{id}"
          }
        },
        "delete": {
          "name": "deleteBook",
          "method": "DELETE",
          "path": "/books/{id}",
          "descriptionTemplate": "Delete book with id {id}",
          "params": [
            "id"
          ]
        },
        "get": {
          "name": "getBook",
          "method": "GET",
          "path": "/books/{id}",
          "descriptionTemplate": "Get book with id {id}",
          "params": [
            "id"
          ]
        },
        "list": {
          "name": "listBooks",
          "method": "GET",
          "path": "/books",
          "descriptionTemplate": "List/search books"
        }
      }
    },
    "Loan": {
      "displayName": "loan",
      "params": [
        "userId",
        "bookId"
      ],
      "operations": {
        "add": {
          "name": "createLoan",
          "method": "POST",
          "path": "/loans",
          "descriptionTemplate": "Create a loan with userId {userId} and bookId {bookId}",
          "params": [
            "userId",
            "bookId"
          ],
          "bodyTemplate": {
            "userId": "{userId}",
            "bookId": "{bookId}"
          }
        },
        "delete": {
          "name": "deleteLoan",
          "method": "DELETE",
          "path": "/loans/{userId}/{bookId}",
          "descriptionTemplate": "Delete loan with userId {userId} and bookId {bookId}",
          "params": [
            "userId",
            "bookId"
          ]
        },
        "list": {
          "name": "listLoans",
          "method": "GET",
          "path": "/loans",
          "descriptionTemplate": "List/search loans"
        }
      }
    },
    "Hold": {
      "displayName": "hold",
      "params": [
        "id"
      ],
      "operations": {
        "add": {
          "name": "createHold",
          "method": "POST",
          "path": "/holds",
          "descriptionTemplate": "Create a hold with id {id}",
          "params": [
            "id"
          ],
          "bodyTemplate": {
            "id": "{id}"
          }
        },
        "delete": {
          "name": "deleteHold",
          "method": "DELETE",
          "path": "/holds/{id}",
          "descriptionTemplate": "Delete hold with id {id}",
          "params": [
            "id"
          ]
        },
        "list": {
          "name": "listHolds",
          "method": "GET",
          "path": "/holds",
          "descriptionTemplate": "List holds"
        }
      }
    }
  },
  "stories": []
}