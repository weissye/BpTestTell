{
  "Authentication": {
    "operations": {
      "add": {
        "name": "passwordReset",
        "descriptionTemplate": "The request a password reset endpoint sends an email with a link to the admin app which in turn uses this endpoint to allow the user to reset their password.",
        "method": "POST",
        "path": "/auth/password/reset",
        "params": [
          "token",
          "password"
        ],
        "bodyTemplate": {
          "token": "{token}",
          "password": "{password}"
        },
        "paramTypes": {
          "token": "string",
          "password": "string"
        }
      },
      "list": {
        "name": "oauth",
        "descriptionTemplate": "List configured OAuth providers.",
        "method": "GET",
        "path": "/auth/oauth",
        "params": [],
        "bodyTemplate": null,
        "paramTypes": {
          "public": "boolean"
        }
      },
      "get": {
        "name": "oauthProvider",
        "descriptionTemplate": "Start OAuth flow using the specified provider",
        "method": "GET",
        "path": "/auth/oauth/{provider}",
        "params": [
          "provider",
          "redirect"
        ],
        "bodyTemplate": null,
        "paramTypes": {
          "provider": "string",
          "redirect": "string"
        }
      }
    }
  }
}