{
  "Milestones": {
    "operations": {
      "delete": {
        "name": "issueDeleteMilestone",
        "descriptionTemplate": "Delete a milestone",
        "method": "DELETE",
        "path": "/repos/{owner}/{repo}/milestones/{id}",
        "params": [
          "owner",
          "repo",
          "id"
        ],
        "bodyTemplate": {},
        "paramTypes": {
          "owner": "string",
          "repo": "string",
          "id": "string"
        },
        "x-negative-delete-expected-codes": [
          404
        ]
      },
      "get": {
        "name": "issueGetMilestone",
        "descriptionTemplate": "Get a milestone",
        "method": "GET",
        "path": "/repos/{owner}/{repo}/milestones/{id}",
        "params": [
          "owner",
          "repo",
          "id"
        ],
        "bodyTemplate": {},
        "paramTypes": {
          "owner": "string",
          "repo": "string",
          "id": "string"
        }
      },
      "update": {
        "name": "issueEditMilestone",
        "descriptionTemplate": "Update a milestone",
        "method": "PATCH",
        "path": "/repos/{owner}/{repo}/milestones/{id}",
        "params": [
          "owner",
          "repo",
          "id"
        ],
        "bodyTemplate": {
          "title": "{title}",
          "state": "{state}",
          "description": "{description}",
          "due_on": "{due_on}"
        },
        "paramTypes": {
          "owner": "string",
          "repo": "string",
          "id": "string",
          "title": "string",
          "state": "string",
          "description": "string",
          "due_on": "string"
        }
      }
    }
