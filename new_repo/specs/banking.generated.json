{
  "sut": "banking",
  "entities": {
    "Customer": {
      "displayName": "customer",
      "params": [
        "id",
        "name"
      ],
      "operations": {
        "add": {
          "name": "addCustomer",
          "method": "POST",
          "path": "/customers",
          "descriptionTemplate": "Add a customer with id {id} and name {name}",
          "bodyTemplate": {
            "id": "{id}",
            "name": "{name}"
          }
        },
        "delete": {
          "name": "deleteCustomer",
          "method": "DELETE",
          "path": "/customers/{id}",
          "descriptionTemplate": "Delete a customer with id {id} and name {name}"
        },
        "verifyExists": {
          "name": "verifyCustomerExists"
        }
      },
      "waitForPatterns": {
        "added": {
          "name": "waitForAnyCustomerAdded",
          "descriptionRegex": "Add a customer with id (.+) and name (.+)"
        },
        "deleted": {
          "name": "waitForAnyCustomerDeleted",
          "descriptionRegex": "Delete a customer with id (.+) and name (.+)"
        }
      }
    },
