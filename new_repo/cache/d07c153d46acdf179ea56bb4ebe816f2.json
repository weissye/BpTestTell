{
  "WikiPages": {
    "operations": {
      "list": {
        "name": "repoGetWikiPages",
        "descriptionTemplate": "Get all wiki pages",
        "method": "GET",
        "path": "/repos/{owner}/{repo}/wiki/pages",
        "params": [
          "owner",
          "repo",
          "page",
          "limit"
        ],
        "bodyTemplate": {},
        "paramTypes": {
          "owner": "string",
          "repo": "string",
          "page": "integer",
          "limit": "integer"
        }
      }
    }
  },
  "WikiPageRevisions": {
    "operations": {
      "list": {
        "name": "repoGetWikiPageRevisions",
        "descriptionTemplate": "Get revisions of a wiki page",
        "method": "GET",
        "path": "/repos/{owner}/{repo}/wiki/revisions/{pageName}",
        "params": [
          "owner",
          "repo",
          "pageName",
          "page"
        ],
        "bodyTemplate": {},
        "paramTypes": {
          "owner": "string",
          "repo": "string",
          "pageName": "string",
          "page": "integer"
        }
      }
    }
  },
  "Repositories": {
    "operations": {
      "add": {
        "name": "generateRepo",
        "descriptionTemplate": "Create a repository using a template",
        "method": "POST",
        "path": "/repos/{template_owner}/{template_repo}/generate",
        "params": [
          "template_owner",
          "template_repo"
        ],
        "bodyTemplate": {
          "body": "{body}"
        },
        "paramTypes": {
          "template_owner": "string",
          "template_repo": "string",
          "body": "object"
        }
      },
      "get": {
        "name": "repoGetByID",
        "descriptionTemplate": "Get a repository by id",
        "method": "GET",
        "path": "/repositories/{id}",
        "params": [
          "id"
        ],
        "bodyTemplate": {},
        "paramTypes": {
          "id": "integer"
        }
      }
    }
  },
  "Settings": {
    "operations": {
      "get": {
        "name": "getGeneralAPISettings",
        "descriptionTemplate": "Get instance's global settings for api",
        "method": "GET",
        "path": "/settings/api",
        "params": [],
        "bodyTemplate": {},
        "paramTypes": {}
      }
    }
